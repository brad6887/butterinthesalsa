{
  "name": "butter-salsa-loopback-test",
  "main": "test/local-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "POLL_OPEN": "true",
    "ALLOWED_ORIGINS": "http://localhost:4321",
    "TURNSTILE_HOSTNAMES": "localhost"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "butter-salsa-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ADMISSION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
