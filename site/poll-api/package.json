{
  "name": "butter-salsa-poll-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.js",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview:local": "wrangler dev --local --ip 127.0.0.1 --port 8787 --config wrangler.local.json --persist-to .wrangler/preview-data",
    "migrate:preview": "wrangler d1 migrations apply DB --local --config wrangler.local.json --persist-to .wrangler/preview-data",
    "test:browser": "node test/browser.mjs",
    "preview:real": "wrangler dev --local --ip 127.0.0.1 --port 8788 --config wrangler.real-local.json --persist-to .wrangler/real-preview",
    "migrate:real": "wrangler d1 migrations apply DB --local --config wrangler.real-local.json --persist-to .wrangler/real-preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1",
    "wrangler": "4.151.1"
  }
}
