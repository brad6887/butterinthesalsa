---
const title = 'Butter in the Salsa';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Some friendships are built on questionable recipes." />
    <title>{title}</title>
    <style>
      :root { font-family: Georgia, serif; color: #fff5d5; background: #8b261b; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; padding: 2rem; }
      main { max-width: 52rem; text-align: center; }
      .eyebrow { font: 700 .8rem system-ui, sans-serif; letter-spacing: .2em; text-transform: uppercase; }
      h1 { font-size: clamp(3.5rem, 12vw, 8rem); line-height: .95; margin: 1.5rem 0; letter-spacing: -.05em; }
      h1 span { color: #ffdb67; }
      .intro { font-size: clamp(1.2rem, 3vw, 1.6rem); line-height: 1.6; }
      footer { margin-top: 4rem; font: .9rem system-ui, sans-serif; }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">A questionable culinary decision</p>
      <h1>Butter in<br />the <span>Salsa.</span></h1>
      <p class="intro">Some friendships are built on questionable recipes.<br />This one got a domain name.</p>
      <footer>Pass the chips. We have explaining to do.</footer>
    </main>
  </body>
</html>
