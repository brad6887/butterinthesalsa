---
import { Picture } from 'astro:assets';
import ReunionPoll from '../components/ReunionPoll.astro';
import splash from '../assets/ButterintheSalsa.png';
const title = 'Butter in the Salsa';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline id="canonical-https">
      if (location.protocol === 'http:' && location.hostname === 'butterinthesalsa.com') {
        const secure = new URL(location.href);
        secure.protocol = 'https:';
        secure.port = '';
        location.replace(secure.href);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Butter in the Salsa. A big debate. A small ingredient. Some things can’t be unsqueezed." />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <style>
      :root { font-family: system-ui, sans-serif; color: #fff5df; background: #21140e; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .artwork { width: min(100%, 1370px); }
      .artwork :global(img) { display: block; width: 100%; height: auto; }
      .message { text-align: center; padding: 1.25rem; max-width: 40rem; }
      h1 { font: 700 clamp(1.5rem, 5vw, 2rem) Georgia, serif; margin: 0 0 .6rem; }
      p { line-height: 1.6; margin: .35rem 0; }
      @media (min-width: 48rem) {
        .artwork { width: min(100%, 1370px, calc(100svh * 1370 / 1148)); }
        .message { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="artwork">
        <Picture src={splash} formats={['webp']} fallbackFormat="jpg"
          widths={[480, 800, 1100, 1370]} sizes="(max-width: 1370px) 100vw, 1370px"
          alt="A smiling pat of butter wearing sunglasses sits in a bowl of salsa beside tortilla chips and a handwritten butter-in-salsa ballot."
          loading="eager" fetchpriority="high" />
      </div>
      <div class="message">
        <h1>Butter in the Salsa</h1>
        <p>A big debate. A small ingredient.</p>
        <p>Some things can’t be unsqueezed.</p>
      </div>
      <ReunionPoll />
    </main>
  </body>
</html>
