# Abbey generated working files
working/session-context/*
!working/session-context/.gitkeep

# Generated Abbey runtime state
.abbey/ai/
.abbey/context/
.abbey/knowledge/

# Local Abbey configuration
.abbey/config.conf

# Astro dependencies and build output
site/node_modules/
site/dist/
site/.astro/
logs/

# Poll local dependencies, private configuration and isolated databases
site/poll-api/node_modules/
site/poll-api/.wrangler/
site/poll-api/.dev.vars*
site/.env*
!site/.env.example
